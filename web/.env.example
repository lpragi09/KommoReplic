# Copie para .env.local e preencha. Nunca commite .env.local.
# Sem nada preenchido, o app roda com o repositório falso em memória.

# "supabase" liga o banco real; vazio = repositório falso
NEXT_PUBLIC_DATA_BACKEND=

# Supabase (Project Settings → API). A publishable vai para o navegador; a secret NUNCA.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Login com Google: 1 mostra o botão (ligue o provedor Google no Supabase → Authentication → Providers e
# cadastre https://SEU_DOMINIO/auth/callback nas URLs de redirecionamento)
NEXT_PUBLIC_GOOGLE_LOGIN=

# URL pública do app (links de retorno do Stripe, emails)
APP_URL=http://localhost:3000

# Stripe (modo de teste primeiro: sk_test_..., whsec_...)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Meta / WhatsApp Cloud API (app da Meta de vocês)
# Empresas que usam o próprio app cadastram a chave secreta dele no canal; esta vale para o app do Recadi.
META_APP_SECRET=
META_VERIFY_TOKEN=

# Chave que cifra os tokens dos canais no banco (gere uma longa e aleatória; não troque depois:
# os tokens já salvos só abrem com ela). Sem ela, usa a SUPABASE_SECRET_KEY; em produção é obrigatória uma das duas.
CHANNEL_SECRET_KEY=

# Agente de IA (Claude). Sem chave, a tela do agente avisa e nada é enviado.
ANTHROPIC_API_KEY=
# Opcional: outro modelo (padrão claude-opus-5-5)
AI_MODEL=

# Rota /api/cron/robots (a Vercel manda "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=

# Limite de tentativas compartilhado entre as instâncias (Upstash Redis → REST API). Sem isso, fica em memória.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Email transacional (convites, avisos)
RESEND_API_KEY=
EMAIL_FROM=

# Galeria do design system em /design (desligada em produção; 1 liga)
SHOW_DESIGN=
